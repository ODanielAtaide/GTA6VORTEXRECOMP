+void test_clwb_loop_patch() {
+    constexpr uint8_t loop[] = {
+        0x66, 0x0F, 0xAE, 0x30, 0x48, 0x83, 0xC0, 0x40, 0x48, 0x39, 0xC8, 0x76, 0xF3,
+    };
+    uint8_t code[sizeof loop];
+    std::memcpy(code, loop, sizeof loop);
+    ce::Host host{};
+    host.clflush = true;
+    check(ce::patch_clwb_loops(code, sizeof code - 1, host) == 0, "a truncated cache loop is unchanged");
+    code[sizeof code - 1] = 0;
+    check(ce::patch_clwb_loops(code, sizeof code, host) == 0, "a different branch target is unchanged");
+    std::memcpy(code, loop, sizeof loop);
+    check(ce::patch_clwb_loops(code, sizeof code, host) == 1, "recognizes a loop on a CLFLUSH host");
+    check(code[0] == 0x90 && code[3] == 0x38 && std::memcmp(code + 4, loop + 4, sizeof loop - 4) == 0,
+          "CLFLUSH preserves the loop and branch");
+    std::memcpy(code, loop, sizeof loop);
+    host.clflushopt = true;
+    check(ce::patch_clwb_loops(code, sizeof code, host) == 1, "recognizes a loop on a CLFLUSHOPT host");
+    check(code[0] == 0x66 && code[3] == 0x38 && std::memcmp(code + 4, loop + 4, sizeof loop - 4) == 0,
+          "CLFLUSHOPT preserves the loop and branch");
+    std::memcpy(code, loop, sizeof loop);
+    host.clwb = true;
+    check(ce::patch_clwb_loops(code, sizeof code, host) == 0 &&
+          std::memcmp(code, loop, sizeof loop) == 0, "native CLWB is unchanged");
+}
