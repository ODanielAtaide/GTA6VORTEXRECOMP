+// Rewrite the entire recognized loop shape before its executable section runs.
+// CLFLUSHOPT or CLFLUSH also writes back dirty data, with the additional cache
+// invalidation. Neither changes flags, operands, instruction lengths or control flow.
+inline std::size_t patch_clwb_loops(uint8_t* code, std::size_t size, const Host& host) {
+    if (host.clwb || (!host.clflushopt && !host.clflush)) return 0;
+    constexpr uint8_t loop[] = {
+        0x66, 0x0F, 0xAE, 0x30,   // clwb [rax]
+        0x48, 0x83, 0xC0, 0x40,   // add rax, 64
+        0x48, 0x39, 0xC8,         // cmp rax, rcx
+        0x76, 0xF3,               // jbe back to clwb
+    };
+    if (size < sizeof loop) return 0;
+    std::size_t patched = 0;
+    for (std::size_t offset = 0; offset <= size - sizeof loop; ++offset) {
+        auto* site = code + offset;
+        if (site[0] != loop[0] || std::memcmp(site, loop, sizeof loop) != 0) continue;
+        if (!host.clflushopt) site[0] = 0x90;  // nop; clflush [rax]
+        site[3] = 0x38;                      // ModR/M /7 instead of CLWB's /6
+        ++patched;
+        offset += sizeof loop - 1;
+    }
+    return patched;
+}
