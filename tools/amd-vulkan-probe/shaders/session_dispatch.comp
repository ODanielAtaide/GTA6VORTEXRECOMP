#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer Data { uint values[]; } data;
layout(push_constant) uniform Constants { uint multiplier; uint addend; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    data.values[i] = data.values[i] * pc.multiplier + pc.addend + i;
}
